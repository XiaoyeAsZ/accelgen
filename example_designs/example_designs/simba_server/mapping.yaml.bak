mapping:
  # Force full spatial utilization of all 262144 MACs (512x512)
  # distributed_buffers: meshY=512, map M dimension spatially
  - target: distributed_buffers
    type: spatial
    factors: M=512
    permutation: [M, C, Q, R, S, P, N]
    split: 0  # Map to Y direction

  # reg_mac: meshY=512, map C (reduction) dimension spatially
  - target: reg_mac
    type: spatial
    factors: C=512
    permutation: [C, M, Q, R, S, P, N]
    split: 0  # Map to Y direction
