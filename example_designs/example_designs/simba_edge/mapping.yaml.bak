mapping:
  # Force full spatial utilization of all 4096 MACs (64x64)
  # distributed_buffers: meshY=64, map M dimension spatially
  - target: distributed_buffers
    type: spatial
    factors: M=64
    permutation: [M, C, Q, R, S, P, N]
    split: 0  # Map to Y direction

  # reg_mac: meshY=64, map C (reduction) dimension spatially
  - target: reg_mac
    type: spatial
    factors: C=64
    permutation: [C, M, Q, R, S, P, N]
    split: 0  # Map to Y direction
